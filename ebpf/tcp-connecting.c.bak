#include "bpf_all.h"
#include "define/socket.h"

struct {
    __uint(type, BPF_MAP_TYPE_PROG_ARRAY);
    __uint(key_size, 4);
    __uint(value_size, 4);
    __uint(max_entries, 1);
} progs SEC(".maps");

struct {
    __uint(type, BPF_MAP_TYPE_PERCPU_ARRAY);
    __type(key, __u32);
    __type(value, __u64);
    __uint(max_entries, 1);
} socks SEC(".maps");


struct tcp_fd_info {
    __u64 file;
    __u64 newfile;
};

struct inet_sock_set_state_args {
    __u64 unused;
    __u64 skaddr;
    int oldstate;
    int newstate;
    __u16 sport;
    __u16 dport;
    __u16 family;
    __u32 saddr;
    __u32 daddr;
};

struct event_t {
    int oldstate;
    int newstate;
    __u16 sport;
    __u16 dport;
    __u16 family;
    __u32 saddr;
    __u32 daddr;
    __u16 type;
} __attribute__((packed));

// #if defined(USE_RING_BUF)
struct {
    __uint(type, BPF_MAP_TYPE_RINGBUF);
    __uint(max_entries, 1024 * 1024);
} events SEC(".maps");

static __noinline void handle_new_connection(void *ctx, struct sock *sk, __be16 type, struct inet_sock_set_state_args *args)
{
    struct event_t *event;
    int _err = 0;
    int *err = &_err;
    guard_ringbuf(&events, event, err);
    if (!event) {
        return;
    }
    if (sk) {
        event->type = type;
        event->saddr = BPF_CORE_READ(sk, __sk_common.skc_rcv_saddr);
        event->sport = BPF_CORE_READ(sk, __sk_common.skc_num);
        event->dport = bpf_ntohs(BPF_CORE_READ(sk, __sk_common.skc_dport));
        event->daddr = BPF_CORE_READ(sk, __sk_common.skc_daddr);
    }

    if (args) {
        __builtin_memcpy(&event->saddr, &args->saddr, sizeof(event->saddr));
        __builtin_memcpy(&event->daddr, &args->daddr, sizeof(event->daddr));

        event->sport = args->sport;
        event->dport = args->dport;
        event->family = args->family;
        event->oldstate = args->oldstate;
        event->newstate = args->newstate;
    }
}
